# --- caching ---
# Cross-process cache for baked geometry. The in-process byte budget (v0.3.731) bounds ONE worker;
# under gunicorn/uvicorn with N workers the same model is tessellated N times because a dict cannot
# span processes. diskcache is a lock-correct SQLite-backed store — the part that is genuinely hard to
# write by hand, which is why this dependency earns its place where `cachetools` did not.
diskcache>=5.6            # Apache-2.0, pure-Python, no C extension

# --- optional (lazy-imported, only when the matching env var is set) ---
