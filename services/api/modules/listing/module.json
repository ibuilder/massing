{
  "key": "listing",
  "name": "Listings",
  "section": "Market & Sales",
  "icon": "⌂",
  "ref_prefix": "LST",
  "title_field": "address",
  "fields": [
    {
      "name": "address",
      "label": "Address / project name",
      "type": "text",
      "required": true,
      "fieldset": "Identity"
    },
    {
      "name": "city",
      "label": "City",
      "type": "text",
      "fieldset": "Identity"
    },
    {
      "name": "virtual_tour_url",
      "label": "Virtual tour / 3D link",
      "type": "text",
      "fieldset": "Identity"
    },
    {
      "name": "zip_code",
      "label": "ZIP",
      "type": "text",
      "fieldset": "Identity"
    },
    {
      "name": "asset_type",
      "label": "Asset type",
      "type": "select",
      "options": [
        "Residential",
        "Multifamily",
        "Office",
        "Retail",
        "Industrial",
        "Mixed-use",
        "Land",
        "Specialty"
      ],
      "fieldset": "Classification"
    },
    {
      "name": "list_date",
      "label": "List date",
      "type": "date",
      "fieldset": "Dates"
    },
    {
      "name": "list_price",
      "label": "List price",
      "type": "currency",
      "fieldset": "Money"
    },
    {
      "name": "noi",
      "label": "Stabilized NOI",
      "type": "currency",
      "fieldset": "Money"
    },
    {
      "name": "price_psf",
      "label": "$/SF",
      "type": "number",
      "unit": "$/sf",
      "fieldset": "Money"
    },
    {
      "name": "baths",
      "label": "Bathrooms",
      "type": "number",
      "fieldset": "Quantities"
    },
    {
      "name": "beds",
      "label": "Bedrooms",
      "type": "number",
      "fieldset": "Quantities"
    },
    {
      "name": "cap_rate",
      "label": "Cap rate %",
      "type": "number",
      "fieldset": "Quantities"
    },
    {
      "name": "lot_sqft",
      "label": "Lot SF",
      "type": "number",
      "fieldset": "Quantities"
    },
    {
      "name": "num_units",
      "label": "Units",
      "type": "number",
      "fieldset": "Quantities"
    },
    {
      "name": "sqft",
      "label": "Living / rentable SF",
      "type": "number",
      "fieldset": "Quantities"
    },
    {
      "name": "year_built",
      "label": "Year built / completion",
      "type": "number",
      "fieldset": "Quantities"
    },
    {
      "name": "state",
      "label": "State",
      "type": "text",
      "fieldset": "Status"
    },
    {
      "name": "highlights",
      "label": "Feature highlights",
      "type": "textarea",
      "fieldset": "Notes"
    },
    {
      "name": "public_description",
      "label": "Public description",
      "type": "textarea",
      "fieldset": "Notes"
    },
    {
      "name": "unit_mix",
      "label": "Unit mix",
      "type": "textarea",
      "fieldset": "Notes"
    }
  ],
  "workflow": {
    "initial": "draft",
    "states": [
      "draft",
      "coming_soon",
      "active",
      "under_contract",
      "sold",
      "leased",
      "withdrawn"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "coming_soon",
        "action": "tease",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      },
      {
        "from": "draft",
        "to": "active",
        "action": "list",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      },
      {
        "from": "coming_soon",
        "to": "active",
        "action": "list",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      },
      {
        "from": "active",
        "to": "under_contract",
        "action": "go_under_contract",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      },
      {
        "from": "active",
        "to": "leased",
        "action": "lease",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      },
      {
        "from": "active",
        "to": "withdrawn",
        "action": "withdraw",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      },
      {
        "from": "under_contract",
        "to": "sold",
        "action": "close_sale",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      },
      {
        "from": "under_contract",
        "to": "leased",
        "action": "close_lease",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      },
      {
        "from": "under_contract",
        "to": "active",
        "action": "reactivate",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      },
      {
        "from": "withdrawn",
        "to": "active",
        "action": "relist",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      }
    ]
  },
  "list_columns": [
    "asset_type",
    "list_price",
    "cap_rate"
  ],
  "workspace": "developer"
}
