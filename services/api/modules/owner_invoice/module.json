{
  "key": "owner_invoice",
  "name": "Owner Invoices",
  "section": "Cost",
  "icon": "$",
  "ref_prefix": "OINV",
  "title_field": "number",
  "pinnable": false,
  "fields": [
    {
      "name": "number",
      "label": "Invoice No.",
      "type": "text",
      "required": true,
      "fieldset": "Identity"
    },
    {
      "name": "period",
      "label": "Period",
      "type": "text",
      "fieldset": "Identity"
    },
    {
      "name": "amount",
      "label": "Amount",
      "type": "currency",
      "fieldset": "Money"
    },
    {
      "name": "status",
      "label": "Status",
      "type": "select",
      "options": [
        "Draft",
        "Submitted",
        "Approved",
        "Rejected",
        "Paid"
      ],
      "fieldset": "Status"
    },
    {
      "name": "prime_contract",
      "label": "Prime contract",
      "type": "reference",
      "module": "prime_contract",
      "fieldset": "Links"
    }
  ],
  "workflow": {
    "initial": "draft",
    "states": [
      "approved",
      "draft",
      "paid",
      "rejected",
      "submitted"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "submitted",
        "action": "submit",
        "party": [
          "GC"
        ]
      },
      {
        "from": "submitted",
        "to": "paid",
        "action": "mark_paid",
        "party": "Owner"
      },
      {
        "from": "submitted",
        "to": "approved",
        "action": "certify",
        "party": "Owner"
      },
      {
        "from": "submitted",
        "to": "rejected",
        "action": "reject",
        "party": "Owner"
      },
      {
        "from": "approved",
        "to": "paid",
        "action": "mark_paid",
        "party": "Owner"
      },
      {
        "from": "rejected",
        "to": "draft",
        "action": "revise",
        "party": [
          "GC"
        ]
      }
    ]
  },
  "list_columns": [
    "amount",
    "status",
    "prime_contract"
  ],
  "workspace": "construction",
  "tools": [
    {
      "dest": "__wip__",
      "label": "WIP schedule"
    }
  ]
}
