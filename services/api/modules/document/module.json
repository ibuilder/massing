{
  "key": "document",
  "name": "Documents",
  "section": "Coordination",
  "icon": "📄",
  "ref_prefix": "DOC",
  "title_field": "title",
  "pinnable": false,
  "revisable": true,
  "fields": [
    {
      "name": "revision",
      "label": "Revision",
      "type": "text",
      "fieldset": "Identity"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "required": true,
      "fieldset": "Identity"
    },
    {
      "name": "discipline",
      "label": "Discipline",
      "type": "select",
      "options": [
        "General",
        "Architectural",
        "Structural",
        "MEP",
        "Civil"
      ],
      "fieldset": "Classification"
    },
    {
      "name": "doc_type",
      "label": "Type",
      "type": "select",
      "options": [
        "Specification",
        "Contract",
        "Permit",
        "Report",
        "Procedure",
        "Other"
      ],
      "fieldset": "Classification"
    },
    {
      "name": "status",
      "label": "Status",
      "type": "select",
      "options": [
        "Draft",
        "Issued",
        "Superseded"
      ],
      "fieldset": "Status"
    },
    {
      "name": "notes",
      "label": "Notes",
      "type": "textarea",
      "fieldset": "Notes"
    },
    {
      "name": "transmittal",
      "label": "Transmittal",
      "type": "reference",
      "module": "transmittal",
      "help": "The transmittal that issued this document — the same link drawings and submittals use, so one package can carry all three.",
      "fieldset": "Links"
    }
  ],
  "workflow": {
    "initial": "draft",
    "states": [
      "draft",
      "issued",
      "superseded",
      "void"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "issued",
        "action": "issue",
        "party": [
          "GC"
        ]
      },
      {
        "from": "issued",
        "to": "void",
        "action": "void",
        "party": [
          "GC"
        ]
      },
      {
        "from": "issued",
        "to": "superseded",
        "action": "supersede",
        "party": [
          "GC"
        ]
      }
    ]
  },
  "list_columns": [
    "doc_type",
    "revision",
    "status"
  ],
  "workspace": "design"
}
