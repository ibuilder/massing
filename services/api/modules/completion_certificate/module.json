{
  "key": "completion_certificate",
  "name": "Completion Certificates",
  "section": "Closeout",
  "icon": "✓",
  "ref_prefix": "CC",
  "title_field": "subject",
  "pinnable": false,
  "fields": [
    {
      "name": "subject",
      "label": "Certificate",
      "type": "text",
      "required": true,
      "fieldset": "Identity"
    },
    {
      "name": "type",
      "label": "Type",
      "type": "select",
      "options": [
        "Substantial",
        "Final",
        "Partial"
      ],
      "fieldset": "Classification"
    },
    {
      "name": "certified_by",
      "label": "Certified By",
      "type": "text",
      "fieldset": "Parties"
    },
    {
      "name": "date",
      "label": "Date",
      "type": "date",
      "fieldset": "Dates"
    },
    {
      "name": "occupancy_date",
      "label": "Owner Occupancy Date",
      "type": "date",
      "fieldset": "Dates"
    },
    {
      "name": "punch_complete_pct",
      "label": "Punch List % Complete",
      "type": "percent",
      "unit": "%",
      "fieldset": "Quantities"
    },
    {
      "name": "record_model_version",
      "label": "Record Model Version",
      "type": "number",
      "fieldset": "Quantities"
    },
    {
      "name": "scope",
      "label": "Scope",
      "type": "textarea",
      "fieldset": "Notes"
    }
  ],
  "workflow": {
    "initial": "draft",
    "states": [
      "accepted",
      "draft",
      "issued"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "issued",
        "action": "issue",
        "party": [
          "GC"
        ]
      },
      {
        "from": "issued",
        "to": "accepted",
        "action": "accept",
        "party": "Owner"
      }
    ]
  },
  "list_columns": [
    "type",
    "date",
    "occupancy_date",
    "punch_complete_pct"
  ],
  "workspace": "construction",
  "tools": [
    {
      "dest": "__turnover__",
      "label": "Certify substantial completion"
    }
  ]
}
