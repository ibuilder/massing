{
  "key": "eticket",
  "name": "eTickets (T&M)",
  "section": "Change Management",
  "icon": "⏱",
  "ref_prefix": "TM",
  "title_field": "subject",
  "pinnable": true,
  "fields": [
    {
      "name": "subject",
      "label": "Subject",
      "type": "text",
      "required": true,
      "fieldset": "Identity"
    },
    {
      "name": "work_date",
      "label": "Date of Work",
      "type": "date",
      "required": true,
      "fieldset": "Dates",
      "default": "@today"
    },
    {
      "name": "labor_total",
      "label": "Labor",
      "type": "currency",
      "fieldset": "Money",
      "min": 0
    },
    {
      "name": "labor_lines",
      "label": "Labor",
      "type": "table",
      "total_column": "amount",
      "fieldset": "Money",
      "columns": [
        {
          "name": "worker",
          "label": "Worker / crew",
          "type": "text"
        },
        {
          "name": "trade",
          "label": "Trade",
          "type": "text"
        },
        {
          "name": "classification",
          "label": "Class",
          "type": "select",
          "options": [
            "Journeyman",
            "Apprentice",
            "Foreman",
            "General Foreman",
            "Superintendent"
          ]
        },
        {
          "name": "hours",
          "label": "Hours",
          "type": "number",
          "unit": "hr"
        },
        {
          "name": "ot_hours",
          "label": "OT hours",
          "type": "number",
          "unit": "hr"
        },
        {
          "name": "rate",
          "label": "Rate",
          "type": "currency",
          "unit": "$/hr"
        },
        {
          "name": "amount",
          "label": "Amount",
          "type": "currency"
        }
      ],
      "totals_into": "labor_total"
    },
    {
      "name": "material_total",
      "label": "Material",
      "type": "currency",
      "fieldset": "Money",
      "min": 0
    },
    {
      "name": "material_lines",
      "label": "Material",
      "type": "table",
      "total_column": "amount",
      "fieldset": "Money",
      "columns": [
        {
          "name": "description",
          "label": "Description",
          "type": "text"
        },
        {
          "name": "qty",
          "label": "Qty",
          "type": "number"
        },
        {
          "name": "unit",
          "label": "Unit",
          "type": "text"
        },
        {
          "name": "unit_price",
          "label": "Unit price",
          "type": "currency"
        },
        {
          "name": "amount",
          "label": "Amount",
          "type": "currency"
        }
      ],
      "totals_into": "material_total"
    },
    {
      "name": "equipment_total",
      "label": "Equipment",
      "type": "currency",
      "fieldset": "Money",
      "min": 0
    },
    {
      "name": "equipment_lines",
      "label": "Equipment",
      "type": "table",
      "total_column": "amount",
      "fieldset": "Money",
      "columns": [
        {
          "name": "equipment",
          "label": "Equipment",
          "type": "text"
        },
        {
          "name": "hours",
          "label": "Hours",
          "type": "number",
          "unit": "hr"
        },
        {
          "name": "idle_hours",
          "label": "Idle hours",
          "type": "number",
          "unit": "hr"
        },
        {
          "name": "rate",
          "label": "Rate",
          "type": "currency",
          "unit": "$/hr"
        },
        {
          "name": "amount",
          "label": "Amount",
          "type": "currency"
        }
      ],
      "totals_into": "equipment_total"
    },
    {
      "name": "signed_by",
      "label": "Signed by (field)",
      "type": "text",
      "fieldset": "Sign-off"
    },
    {
      "name": "signed_on",
      "label": "Signed on",
      "type": "date",
      "fieldset": "Sign-off"
    },
    {
      "name": "signature",
      "label": "Field signature",
      "type": "signature",
      "fieldset": "Sign-off"
    },
    {
      "name": "gc_approved_by",
      "label": "Approved by (GC)",
      "type": "text",
      "fieldset": "Sign-off"
    },
    {
      "name": "gc_approved_on",
      "label": "Approved on",
      "type": "date",
      "fieldset": "Sign-off"
    },
    {
      "name": "change_event",
      "label": "Change event",
      "type": "reference",
      "module": "change_event",
      "fieldset": "Links"
    }
  ],
  "workflow": {
    "initial": "draft",
    "states": [
      "draft",
      "super_signed",
      "gc_signed",
      "billed"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "super_signed",
        "action": "super_sign",
        "party": [
          "Subcontractor",
          "GC"
        ],
        "requires": [
          "signed_by",
          "signature"
        ]
      },
      {
        "from": "super_signed",
        "to": "gc_signed",
        "action": "gc_sign",
        "party": [
          "GC"
        ],
        "requires": [
          "gc_approved_by"
        ]
      },
      {
        "from": "gc_signed",
        "to": "billed",
        "action": "bill",
        "party": [
          "GC"
        ]
      }
    ]
  },
  "workspace": "construction",
  "list_columns": [
    "work_date",
    "labor_total",
    "material_total",
    "signed_by"
  ]
}
