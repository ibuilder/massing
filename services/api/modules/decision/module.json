      {
        "from": "decided",
        "to": "open",
        "action": "revisit",
        "party": [
          "GC",
          "OwnersRep"
        ]
      },
      {
        "from": "decided",
        "to": "superseded",
        "action": "supersede",
        "party": [
          "GC"
        ]
      }
    ]
  },
  "list_columns": [
    "category",
    "alignment",
    "cost_impact",
    "due_date"
  ],
  "workspace": "construction"
}
