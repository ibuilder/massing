      "options": [
        "Design",
        "Scope",
        "Budget",
        "Schedule",
        "Systems",
        "Site",
        "Other"
      ],
      "fieldset": "Classification"
    },
    {
      "name": "decided_by",
      "label": "Decided By",
      "type": "text",
      "fieldset": "Parties"
    },
    {
      "name": "due_date",
      "label": "Decide By",
      "type": "date",
      "fieldset": "Dates"
    },
    {
      "name": "cost_impact",
      "label": "Cost Impact",
      "type": "currency",
      "fieldset": "Money"
    },
    {
      "name": "schedule_impact_days",
      "label": "Schedule Impact (days)",
      "type": "number",
      "unit": "days",
      "fieldset": "Quantities"
    },
    {
      "name": "alternatives",
      "label": "Alternatives considered",
      "type": "textarea",
      "fieldset": "Notes"
    },
    {
      "name": "decision",
      "label": "Decision made",
      "type": "textarea",
      "fieldset": "Notes"
    },
    {
      "name": "rationale",
      "label": "Rationale",
      "type": "textarea",
      "fieldset": "Notes"
    }
