{
  "key": "investor",
  "name": "Investors",
  "section": "Finance",
  "icon": "💼",
  "ref_prefix": "INV",
  "title_field": "investor",
  "fields": [
    {
      "name": "email",
      "label": "Email",
      "type": "text",
      "fieldset": "Identity"
    },
    {
      "name": "investor",
      "label": "Investor",
      "type": "text",
      "required": true,
      "fieldset": "Identity"
    },
    {
      "name": "investor_company",
      "label": "Entity (directory)",
      "type": "reference",
      "module": "company",
      "fieldset": "Identity"
    },
    {
      "name": "entity_type",
      "label": "Entity type",
      "type": "select",
      "options": [
        "Individual",
        "LLC",
        "Trust",
        "IRA",
        "Partnership",
        "Corporation"
      ],
      "fieldset": "Classification"
    },
    {
      "name": "investor_class",
      "label": "Class",
      "type": "select",
      "options": [
        "LP",
        "GP",
        "Co-GP"
      ],
      "fieldset": "Classification"
    },
    {
      "name": "date_committed",
      "label": "Date committed",
      "type": "date",
      "fieldset": "Dates"
    },
    {
      "name": "commitment",
      "label": "Commitment",
      "type": "currency",
      "required": true,
      "fieldset": "Money"
    },
    {
      "name": "contributed",
      "label": "Contributed to date",
      "type": "currency",
      "fieldset": "Money"
    },
    {
      "name": "distributed",
      "label": "Distributed to date",
      "type": "currency",
      "fieldset": "Money"
    },
    {
      "name": "ownership_pct",
      "label": "Ownership / interest %",
      "type": "percent",
      "unit": "%",
      "fieldset": "Money",
      "min": 0,
      "max": 100
    },
    {
      "name": "pref_return_pct",
      "label": "Preferred return %",
      "type": "percent",
      "unit": "%",
      "fieldset": "Money",
      "min": 0,
      "max": 100
    },
    {
      "name": "notes",
      "label": "Notes",
      "type": "textarea",
      "fieldset": "Notes"
    }
  ],
  "workflow": {
    "initial": "prospect",
    "states": [
      "prospect",
      "committed",
      "funded",
      "exited"
    ],
    "transitions": [
      {
        "from": "prospect",
        "to": "committed",
        "action": "commit",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ],
        "requires": [
          "commitment"
        ]
      },
      {
        "from": "committed",
        "to": "funded",
        "action": "fund",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      },
      {
        "from": "funded",
        "to": "exited",
        "action": "exit",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      },
      {
        "from": "committed",
        "to": "prospect",
        "action": "rescind",
        "party": [
          "GC",
          "Owner",
          "OwnersRep"
        ]
      }
    ]
  },
  "list_columns": [
    "investor_class",
    "commitment",
    "contributed"
  ],
  "workspace": "developer"
}
