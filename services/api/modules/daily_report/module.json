{
  "key": "daily_report",
  "name": "Daily Reports",
  "section": "Field",
  "icon": "☼",
  "ref_prefix": "DR",
  "title_field": "report_date",
  "pinnable": false,
  "fields": [
    {
      "name": "report_date",
      "label": "Date",
      "type": "date",
      "required": true,
      "fieldset": "Conditions",
      "default": "@today"
    },
    {
      "name": "weather",
      "label": "Weather",
      "type": "select",
      "options": [
        "Clear",
        "Partly Cloudy",
        "Overcast",
        "Rain",
        "Snow",
        "Wind",
        "Fog",
        "Extreme Heat",
        "Freezing"
      ],
      "fieldset": "Conditions"
    },
    {
      "name": "temp_f",
      "label": "Temp (Â°F)",
      "type": "number",
      "fieldset": "Conditions",
      "unit": "°F"
    },
    {
      "name": "weather_impact",
      "label": "Weather Impact",
      "type": "select",
      "options": [
        "None",
        "Minor Delay",
        "Half-Day Lost",
        "Full-Day Lost",
        "Stoppage"
      ],
      "fieldset": "Conditions"
    },
    {
      "name": "manpower",
      "label": "Manpower Count",
      "type": "number",
      "fieldset": "Work"
    },
    {
      "name": "crew_by_trade",
      "label": "Crew by trade",
      "type": "table",
      "columns": [
        {
          "name": "trade",
          "label": "Trade",
          "type": "text"
        },
        {
          "name": "company",
          "label": "Company",
          "type": "text"
        },
        {
          "name": "headcount",
          "label": "Workers",
          "type": "number"
        },
        {
          "name": "hours",
          "label": "Hours",
          "type": "number",
          "unit": "hr"
        }
      ],
      "total_column": "headcount",
      "fieldset": "Work"
    },
    {
      "name": "work_performed",
      "label": "Work Performed",
      "type": "textarea",
      "fieldset": "Work"
    },
    {
      "name": "deliveries",
      "label": "Deliveries Received",
      "type": "textarea",
      "fieldset": "Site"
    },
    {
      "name": "equipment_on_site",
      "label": "Equipment on site",
      "type": "table",
      "columns": [
        {
          "name": "equipment",
          "label": "Equipment",
          "type": "text"
        },
        {
          "name": "count",
          "label": "Count",
          "type": "number"
        },
        {
          "name": "hours",
          "label": "Hours",
          "type": "number",
          "unit": "hr"
        }
      ],
      "total_column": "hours",
      "fieldset": "Site"
    },
    {
      "name": "delays",
      "label": "Delays / Disruptions",
      "type": "textarea",
      "fieldset": "Site"
    },
    {
      "name": "visitors",
      "label": "Visitors / Inspections",
      "type": "textarea",
      "fieldset": "Safety & record"
    },
    {
      "name": "safety_note",
      "label": "Safety Observations",
      "type": "textarea",
      "fieldset": "Safety & record"
    },
    {
      "name": "photos",
      "label": "Photo Links",
      "type": "textarea",
      "fieldset": "Safety & record"
    },
    {
      "name": "crew_total",
      "label": "Crew (total)",
      "type": "rollup",
      "source_module": "manpower_log",
      "source_field": "count",
      "op": "sum"
    },
    {
      "name": "equip_hours",
      "label": "Equipment hrs",
      "type": "rollup",
      "source_module": "equipment_log",
      "source_field": "hours",
      "op": "sum"
    }
  ],
  "list_columns": [
    "report_date",
    "weather",
    "manpower",
    "weather_impact"
  ],
  "workflow": {
    "initial": "draft",
    "states": [
      "draft",
      "submitted"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "submitted",
        "action": "submit",
        "party": [
          "GC",
          "Subcontractor"
        ]
      }
    ]
  },
  "workspace": "construction"
}
