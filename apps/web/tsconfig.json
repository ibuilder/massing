{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@massingifc/core-kernel": [
        "./src/vendor/massingifc/core-kernel/index.ts"
      ],
      "@massingifc/plugin-sdk": [
        "./src/vendor/massingifc/plugin-sdk/index.ts"
      ],
      "@massingifc/project-schema": [
        "./src/vendor/massingifc/project-schema/index.ts"
      ],
      "@massingcloud/pdf-viewer": [
        "./src/vendor/massingpdf/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src",
    "scripts",
    "capacitor.config.ts",
    "vendorAlias.ts"
  ],
  "exclude": [
    "src/vendor/**/*.test.ts"
  ]
}
