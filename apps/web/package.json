{
  "name": "@aec/web",
  "version": "0.3.939",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "dev:demo": "node scripts/copy-wasm.mjs && vite --mode demo",
    "prebuild": "node scripts/check-vite-version.mjs && node scripts/copy-wasm.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild:desktop": "node scripts/check-vite-version.mjs && node scripts/copy-wasm.mjs",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.mjs\" capacitor.config.ts",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "lint:fast": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/bundle-budget.mjs",
    "licences": "node scripts/check-licences.mjs",
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "tauri": "tauri",
    "prebuild:mobile": "node scripts/check-vite-version.mjs && node scripts/copy-wasm.mjs",
    "build:mobile": "tsc --noEmit && vite build --mode mobile",
    "cap:sync": "cap sync",
    "mobile:android": "npm run build:mobile && cap sync android && cap open android",
    "mobile:ios": "npm run build:mobile && cap sync ios && cap open ios",
    "gen:api-types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@thatopen/components": "3.4.8",
    "@thatopen/components-front": "3.4.4",
    "@thatopen/fragments": "3.4.7",
    "@thatopen/ui": "3.4.10",
    "camera-controls": "3.1.2",
    "geotiff": "^3.0.5",
    "laz-perf": "^0.0.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "qrcode": "^1.5.4",
    "three": "0.185.1",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/three": "0.185.4",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.8.9",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.77.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
